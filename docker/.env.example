# Copy to docker/.env (gitignored) and set your AI provider's key. Any OpenAI-compatible
# provider works; the values below are the ones this demo was verified on.

AI_PROVIDER=glm
AI_API_KEY=your-zai-coding-plan-key
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-5.3

VISION_PROVIDER=glm
VISION_MODEL=glm-5.3-flash
