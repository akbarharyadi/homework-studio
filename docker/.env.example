# Copy to docker/.env (gitignored) to run the stack on real GLM instead of mock.
# Values confirmed against the Z.AI coding plan (glm-5.3-flash reads images).

AI_PROVIDER=glm
AI_API_KEY=your-zai-coding-plan-key
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-5.3

VISION_PROVIDER=glm
VISION_MODEL=glm-5.3-flash
