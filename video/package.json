{
  "name": "homework-studio-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion videos for Homework Studio: a product walkthrough and a data-driven per-student progress recap.",
  "scripts": {
    "studio": "remotion studio",
    "render:explainer": "remotion render Explainer out/explainer.mp4 --codec h264",
    "render:promo": "remotion render Promo out/promo.mp4 --codec h264",
    "render:teacher": "remotion render TeacherPromo out/teacher-promo.mp4 --codec h264",
    "render:student": "remotion render StudentPromo out/student-promo.mp4 --codec h264",
    "render:admin": "remotion render AdminPromo out/admin-promo.mp4 --codec h264",
    "render:roles": "npm run render:teacher && npm run render:student && npm run render:admin",
    "render:recap": "remotion render Recap out/recap.mp4",
    "render:walkthrough": "remotion render Walkthrough out/walkthrough.mp4",
    "render:all": "npm run render:explainer && npm run render:promo && npm run render:roles && npm run render:walkthrough && npm run render:recap"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.240",
    "@remotion/google-fonts": "^4.0.240",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
