# ---- Homework Studio backend (Go) ----

PORT=8080
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# Self-hosted Postgres (Supabase is managed Postgres, so the same URL works there).
DATABASE_URL=postgres://homework:homework@localhost:5433/homework?sslmode=disable

# Optional Redis (AI response cache). Leave blank to run without it.
REDIS_URL=

# Uploads on local disk.
STORAGE_DIR=./storage

# ---- AI: tutor + explanations ----
# AI_PROVIDER=mock is the default: deterministic, no key, no spend (keeps the demo free).
# For live AI, the recommended provider is GLM (the GLM coding plan) — OpenAI-compatible.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
#
# Recommended — GLM via the Z.AI coding plan (verified working):
#   AI_PROVIDER=glm
#   AI_API_KEY=<your Z.AI coding-plan key>
#   AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#   AI_MODEL=glm-5.3                                      # text; glm-5.3-flash / glm-4.6 also work
#
# Alternatives (also OpenAI-compatible):
#   DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1     AI_MODEL=deepseek-chat
#   OpenAI:   AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini

# ---- Classification (subject / worksheet-type detection) ----
# Defaults to jev (TypeAI). Falls back to a keyword classifier when no key is set.
CLASSIFIER_PROVIDER=mock
CLASSIFIER_API_KEY=
CLASSIFIER_BASE_URL=https://api.typeai.co/v1
CLASSIFIER_MODEL=jev

# ---- Vision reader (reads the homework photo, per-answer confidence) ----
# mock = deterministic, free. glm = read real photos with GLM-5.3-flash (verified;
# falls back to mock for PDFs, which need rasterization, and on any error).
VISION_PROVIDER=mock
# Key + base URL fall back to AI_* (same Z.AI coding-plan key) when left blank.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=glm-5.3-flash          # GLM's vision-capable flash model

# ---- Background scheduler (unattended automation) ----
# Auto-generates each student's weekly report + recap-video data on this interval
# (runs once on startup too). Set SCHEDULER_ENABLED=false to turn it off.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=6h

# A homework auto-grades only when every field clears this confidence.
REVIEW_CONFIDENCE_THRESHOLD=0.80

FRONTEND_ORIGIN=http://localhost:3000
