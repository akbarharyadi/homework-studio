# ---- Homework Studio backend (Go) ----

PORT=8080
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# Self-hosted Postgres (Supabase is managed Postgres, so the same URL works there).
DATABASE_URL=postgres://homework:homework@localhost:5433/homework?sslmode=disable

# Optional Redis (AI response cache). Leave blank to run without it.
REDIS_URL=

# Uploads on local disk.
STORAGE_DIR=./storage

# ---- AI: exam generation + teaching notes + tutor ----
# Runs on GLM (the Z.AI coding plan) — OpenAI-compatible. Set AI_API_KEY to enable.
# Without a key the app boots, but exam generation / tutor / material reading are off.
AI_PROVIDER=glm
AI_API_KEY=<your Z.AI coding-plan key>
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-5.3                                      # text; glm-4.6 also works
#
# Alternatives (also OpenAI-compatible — just swap base URL + model):
#   DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1     AI_MODEL=deepseek-chat
#   OpenAI:   AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini

# ---- Vision reader (transcribes the uploaded teaching material) ----
# GLM-5.3-flash reads images and (with poppler) PDFs; text files are read directly.
VISION_PROVIDER=glm
# Key + base URL fall back to AI_* (same Z.AI coding-plan key) when left blank.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=glm-5.3-flash          # GLM's vision-capable flash model

# ---- Background scheduler (unattended automation) ----
# Auto-generates each student's weekly report + recap data, flags at-risk students,
# and builds them remediation practice — on this interval (and once on startup).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=6h

# A generated exam question auto-approves only when its confidence clears this bar.
REVIEW_CONFIDENCE_THRESHOLD=0.80

FRONTEND_ORIGIN=http://localhost:3000
